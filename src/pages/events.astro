---
import Base from '../layouts/Base.astro';
---

<Base title="Events — UUEIRD">
  <main>
    <a href="/" class="back">← UUEIRD</a>
    <h1>Events</h1>
    <p class="empty">No upcoming events.</p>
  </main>
</Base>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .back {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 3rem;
  }

  .back:hover {
    color: var(--color-fg);
    text-decoration: none;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
