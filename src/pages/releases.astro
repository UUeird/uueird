---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allReleases = await getCollection('releases');
const releases = allReleases.sort((a, b) => b.data.date.localeCompare(a.data.date));

const platformLabels: Record<string, string> = {
  bandcamp: 'Bandcamp',
  spotify: 'Spotify',
  apple_music: 'Apple Music',
  soundcloud: 'SoundCloud',
  amazon_music: 'Amazon Music',
  beatport: 'Beatport',
  juno: 'Juno',
};
---

<Base title="Releases — UUeird">
  <main>
    <h1>Releases</h1>
    <div class="grid">
      {releases.map((r) => {
        const { type, id } = r.data.bandcamp_embed;
        const embedUrl = `https://bandcamp.com/EmbeddedPlayer/${type}=${id}/size=large/bgcol=111111/linkcol=ffffff/minimal=true/transparent=true/`;
        return (
          <div
            class="card"
            data-title={r.data.title}
            data-artist={r.data.artist}
            data-artwork={r.data.artwork}
            data-embed={embedUrl}
            data-links={JSON.stringify(r.data.links)}
          >
            <div class="card-inner">
              <img src={r.data.artwork} alt={`${r.data.artist} — ${r.data.title}`} width="300" height="300" />
            </div>
            <div class="info">
              <span class="artist">{r.data.artist}</span>
              <span class="title">{r.data.title}</span>
            </div>
          </div>
        );
      })}
    </div>
  </main>

  <div id="modal" aria-modal="true" role="dialog" aria-hidden="true">
    <div id="modal-backdrop"></div>
    <div id="modal-card">
      <button id="modal-close" aria-label="Close">✕</button>
      <div id="modal-embed-col">
        <iframe id="modal-embed" src="" seamless allow="autoplay"></iframe>
      </div>
      <div id="modal-info-col">
        <span id="modal-artist"></span>
        <span id="modal-title"></span>
        <ul id="modal-links"></ul>
      </div>
    </div>
  </div>
</Base>

<script>
  const platformLabels: Record<string, string> = {
    bandcamp: 'Bandcamp',
    spotify: 'Spotify',
    apple_music: 'Apple Music',
    soundcloud: 'SoundCloud',
    amazon_music: 'Amazon Music',
    beatport: 'Beatport',
    juno: 'Juno',
  };

  const modal      = document.getElementById('modal')!;
  const backdrop   = document.getElementById('modal-backdrop')!;
  const closeBtn   = document.getElementById('modal-close')!;
  const embedFrame = document.getElementById('modal-embed') as HTMLIFrameElement;
  const artistEl   = document.getElementById('modal-artist')!;
  const titleEl    = document.getElementById('modal-title')!;
  const linksEl    = document.getElementById('modal-links')!;

  function openModal(card: HTMLElement) {
    const links: Record<string, string> = JSON.parse(card.dataset.links!);

    embedFrame.src = card.dataset.embed!;
    artistEl.textContent = card.dataset.artist!;
    titleEl.textContent  = card.dataset.title!;

    linksEl.innerHTML = Object.entries(links)
      .filter(([, url]) => url)
      .map(([platform, url]) =>
        `<li><a href="${url}" target="_blank" rel="noopener">${platformLabels[platform] ?? platform}</a></li>`
      ).join('');

    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    // defer clearing src so the close animation plays first
    setTimeout(() => { embedFrame.src = ''; }, 300);
  }

  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
  }

  /* --- grid --- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .card {
    cursor: pointer;
  }

  .card-inner {
    aspect-ratio: 1;
    overflow: hidden;
    background: #1a1a1a;
    margin-bottom: 0.75rem;
  }

  .card-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }

  .card:hover .card-inner img {
    opacity: 0.75;
  }

  @keyframes float-wiggle {
    0%   { transform: translateY(0)    rotate(0deg); }
    20%  { transform: translateY(-6px) rotate(-1.5deg); }
    40%  { transform: translateY(-4px) rotate(1deg); }
    60%  { transform: translateY(-7px) rotate(-0.5deg); }
    80%  { transform: translateY(-3px) rotate(1.5deg); }
    100% { transform: translateY(0)    rotate(0deg); }
  }

  .card:hover .card-inner {
    animation: float-wiggle 1.8s ease-in-out infinite;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .artist {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .title {
    font-size: 0.875rem;
    color: var(--color-fg);
    line-height: 1.3;
  }

  /* --- modal --- */
  #modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  #modal.open {
    display: flex;
  }

  #modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
  }

  #modal-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(800px, 100%);
    background: #111;
    animation: modal-enter 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes modal-enter {
    from { transform: scale(0.85) rotateY(-8deg); opacity: 0; }
    to   { transform: scale(1)    rotateY(0deg);  opacity: 1; }
  }

  #modal-close {
    position: absolute;
    top: -2.25rem;
    right: 0;
    background: none;
    border: none;
    color: var(--color-muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.25rem;
    line-height: 1;
    transition: color 0.15s;
  }

  #modal-close:hover {
    color: var(--color-fg);
  }

  #modal-embed-col {
    aspect-ratio: 1;
  }

  #modal-embed {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  #modal-info-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
    gap: 0.5rem;
  }

  #modal-artist {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  #modal-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  #modal-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  #modal-links a {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    border-bottom: 1px solid #2a2a2a;
    padding-bottom: 0.2em;
    transition: color 0.15s, border-color 0.15s;
  }

  #modal-links a:hover {
    color: var(--color-fg);
    border-color: var(--color-fg);
    text-decoration: none;
  }

  @media (max-width: 560px) {
    #modal-card {
      grid-template-columns: 1fr;
    }
    #modal-embed-col {
      aspect-ratio: 1;
    }
  }
</style>
