---
import Base from '../layouts/Base.astro';
---

<Base title="Releases — UUeird">
  <main>
    <h1>Releases</h1>
    <p class="empty">Coming soon.</p>
  </main>
</Base>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
