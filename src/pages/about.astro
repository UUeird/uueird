---
import Base from '../layouts/Base.astro';
---

<Base title="About — UUeird">
  <main>
    <h1>About</h1>
    <p>UUeird is a music label and event promoter.</p>
  </main>
</Base>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 9rem 2rem 4rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  p {
    color: var(--color-accent);
    max-width: 60ch;
    line-height: 1.7;
  }
</style>
