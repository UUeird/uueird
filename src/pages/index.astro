---
import Base from '../layouts/Base.astro';
---

<Base title="UUeird">
  <main>
    <h1>UUeird</h1>
    <p class="tagline">Music label & event promoter</p>
  </main>
</Base>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
  }

  h1 {
    font-size: clamp(3rem, 12vw, 10rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tagline {
    font-size: 1rem;
    color: var(--color-muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
</style>
