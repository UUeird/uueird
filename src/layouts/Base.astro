<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --color-bg: #0a0a0a;
    --color-fg: #f0f0f0;
    --color-accent: #e0e0e0;
    --color-muted: #666;
    --font-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  html {
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    z-index: 10;
  }

  header .wordmark {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  header .wordmark img {
    height: 6.5rem;
    width: auto;
  }

  header nav {
    display: flex;
    gap: 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 480px) {
    header {
      padding: 1rem;
    }

    header nav {
      gap: 1rem;
    }
  }

  header nav a {
    color: var(--color-muted);
  }

  header nav a:hover {
    color: var(--color-fg);
    text-decoration: none;
  }

  footer {
    display: flex;
    gap: 2rem;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    color: var(--color-muted);
  }

  footer a {
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  footer a:hover {
    color: var(--color-fg);
    text-decoration: none;
  }
</style>
